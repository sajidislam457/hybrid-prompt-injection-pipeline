# Copy to .env and fill in local values. Never commit .env.

# OpenRouter API
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Python API
PYTHON_API=http://127.0.0.1:8000

# Admin console (localhost only — not the public chat UI)
# No sign-in PIN. ADMIN_GESTURE_CODE is unused.
# ADMIN_INTERNAL_TOKEN is optional; default localhost-admin matches Node + Python.
ADMIN_ENABLED=true
ADMIN_HOST=127.0.0.1
ADMIN_PORT=3002
ADMIN_GESTURE_CODE=
ADMIN_INTERNAL_TOKEN=
ADMIN_SESSION_TTL_MIN=480
ADMIN_MAX_FAILS=8
ADMIN_LOCK_MIN=15

# Public Node server
NODE_PORT=3001
NODE_HOST=0.0.0.0
